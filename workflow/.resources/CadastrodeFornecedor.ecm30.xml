function anexarDocumentosNoProcesso() {&#xd;
    var camposDocumentos = [&#xd;
        &quot;anxCartaoCnpjId&quot;,&#xd;
        &quot;anxCompBancoId&quot;,&#xd;
        &quot;anxContratoId&quot;,&#xd;
        &quot;anxRgCpfId&quot;,&#xd;
