        tableHistoricoData: new java.text.SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss&quot;).format(new java.util.Date()),&#xd;
        tableHistoricoAtividade: atividade,&#xd;
        tableHistoricoObservacao: observacao,&#xd;
        tableHistoricoAcao: acao&#xd;
